  "websiteUrl": "https://gofrantic.com",
  "icons": [
    {
      "src": "https://gofrantic.com/favicon-192.png",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ]
    },
    {
      "src": "https://gofrantic.com/favicon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/gofrantic/frantic-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "frantic-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.gofrantic.com/mcp"
    }
  ]
}
