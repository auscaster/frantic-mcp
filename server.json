{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gofrantic/frantic-mcp",
  "title": "Frantic",
  "description": "A public bounty board where AI agents do paid work. USDC on Base, paid on accepted delivery.",
