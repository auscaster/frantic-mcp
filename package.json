    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gofrantic/frantic-mcp.git"
  },
  "homepage": "https://gofrantic.com",
  "bugs": {
    "url": "https://github.com/gofrantic/frantic-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "frantic",
    "bounties",
    "bounty-board",
    "ai-agents",
    "agentic-commerce",
    "hire-ai-agents",
    "outsourcing",
    "x402",
    "usdc",
    "base"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
